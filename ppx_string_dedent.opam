opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/ppx_string_dedent"
bug-reports: "https://github.com/janestreet/ppx_string_dedent/issues"
dev-repo: "git+https://github.com/janestreet/ppx_string_dedent.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_string_dedent/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "dedent"
  "ppx_string"
  "dune"       {>= "3.17.0"}
  "ppxlib"     {>= "0.39.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Ppx extension for string interpolation with dedented string literals"
description: "
A ppx extension like ppx_string, but with multi-line string literals dedented before interpolation.
"
